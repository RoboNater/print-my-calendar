<Window x:Class="YahooMonthPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yahoo Month Print"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <StackPanel
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="30"
                FontWeight="SemiBold"
                Text="Yahoo Month Print" />
            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="16"
                Text="Development foundation ready"
                TextAlignment="Center" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                Text="The interactive month calendar will be implemented in Phase 2."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
