<Window x:Class="YahooMonthPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YahooMonthPrint.App.ViewModels"
        Title="Yahoo Month Print — Offline Demo"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="SidebarHeading" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="#FFF7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8" Background="White" BorderBrush="#FFD7DAE0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button AutomationProperties.Name="Previous month"
                            Command="{Binding PreviousMonthCommand}"
                            Content="◀ _Previous"
                            Style="{StaticResource ToolbarButton}" />
                    <Button AutomationProperties.Name="Go to current month"
                            Command="{Binding TodayCommand}"
                            Content="_Today"
                            Style="{StaticResource ToolbarButton}" />
                    <Button AutomationProperties.Name="Next month"
                            Command="{Binding NextMonthCommand}"
                            Content="_Next ▶"
                            Style="{StaticResource ToolbarButton}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Text="{Binding DisplayedMonthLabel}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Details:" />
                    <ComboBox Width="116"
                              Margin="3"
                              AutomationProperties.Name="Event detail level"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding DetailLevelOptions}"
                              SelectedValue="{Binding SelectedDetailLevel}"
                              SelectedValuePath="Value" />
                    <ComboBox Width="50"
                              Margin="3"
                              AutomationProperties.Name="Maximum description lines"
                              ItemsSource="{Binding DescriptionLineOptions}"
                              SelectedItem="{Binding MaximumDescriptionLines}" />
                    <CheckBox Margin="8,0"
                              VerticalAlignment="Center"
                              Content="_Locations"
                              IsChecked="{Binding ShowLocations}" />
                    <Button AutomationProperties.Name="Reload sample schedule"
                            Command="{Binding RefreshCommand}"
                            Content="↻ _Refresh"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="Reload the offline sample schedule" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14,6" Background="White" BorderBrush="#FFD7DAE0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SidebarHeading}" Text="Filters" />
                        <TextBlock Margin="0,0,0,4" Text="Filter text" />
                        <TextBox MinHeight="30"
                                 Padding="6,4"
                                 AutomationProperties.Name="Filter events by text"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <RadioButton Margin="0,7,0,2"
                                     Content="_Show only matching"
                                     GroupName="QuickFilterMode"
                                     IsChecked="{Binding IsShowOnlyMatching}" />
                        <RadioButton Content="_Hide matching"
                                     GroupName="QuickFilterMode"
                                     IsChecked="{Binding IsHideMatching}" />

                        <TextBlock Style="{StaticResource SidebarHeading}" Text="Calendars" />
                        <ItemsControl ItemsSource="{Binding CalendarFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FilterOptionViewModel}">
                                    <CheckBox MinHeight="26"
                                              AutomationProperties.Name="{Binding Name}"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsEnabled}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,14,0,5">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource SidebarHeading}" Margin="0" Text="Items this month" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button MinHeight="28" Margin="3,0" Command="{Binding ShowAllTitlesCommand}" Content="Show _All" />
                                <Button MinHeight="28" Command="{Binding HideAllTitlesCommand}" Content="_Hide All" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TitleFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FilterOptionViewModel}">
                                    <CheckBox MinHeight="26"
                                              AutomationProperties.Name="{Binding Name}"
                                              Content="{Binding Name}"
                                              IsChecked="{Binding IsEnabled}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Margin="0,14,0,0" Header="{Binding HiddenCountLabel}">
                            <StackPanel Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding HiddenOccurrences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HiddenOccurrenceViewModel}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{Binding Label}" TextWrapping="Wrap" />
                                                <Button Grid.Column="1"
                                                        MinWidth="50"
                                                        MinHeight="28"
                                                        AutomationProperties.Name="Show hidden occurrence"
                                                        Command="{Binding RestoreCommand}"
                                                        Content="_Show" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,6,0,0"
                                        MinHeight="30"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding RestoreAllCommand}"
                                        Content="_Restore All" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="#FF5D626B"
                                           Text="Hiding affects only this local display. Nothing is deleted from Yahoo."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekdayNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                            <Border BorderBrush="#FFB7BBC2" BorderThickness="0.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInDisplayedMonth}" Value="False">
                                                <Setter Property="Background" Value="#FFF0F1F3" />
                                                <Setter Property="Opacity" Value="0.72" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Width="25" Height="25" HorizontalAlignment="Left" CornerRadius="13">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Background" Value="#FF365FA0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.Name="{Binding AccessibleName}"
                                                   Text="{Binding DayNumber}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF20242A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" Margin="0,3,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Occurrences}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:OccurrenceViewModel}">
                                                    <Border x:Name="EventCard"
                                                            Margin="0,1,1,3"
                                                            Padding="5,3"
                                                            AutomationProperties.Name="{Binding AccessibleName}"
                                                            Background="#FFF3F6FA"
                                                            BorderBrush="#FFD5DAE2"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="24" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Margin="0,0,5,0" Background="{Binding CalendarColor}" CornerRadius="2" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock FontSize="10" Foreground="#FF484D55" Text="{Binding TimeText}" />
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                <TextBlock Foreground="#FF30343A" Text="{Binding DescriptionText}" TextWrapping="Wrap" />
                                                                <TextBlock FontSize="10" FontStyle="Italic" Foreground="#FF555B65" Text="{Binding Location}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Width="24"
                                                                    Height="24"
                                                                    Padding="0"
                                                                    VerticalAlignment="Top"
                                                                    AutomationProperties.Name="Hide this occurrence"
                                                                    Command="{Binding HideCommand}"
                                                                    ToolTip="Hide this occurrence locally">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Opacity" Value="0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=EventCard}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE8F5;" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12,7" Background="White" BorderBrush="#FFD7DAE0" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Foreground="#FF4F555E" Text="{Binding StatusText}" />
                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding VisibleCountLabel}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
