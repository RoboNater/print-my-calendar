<Window x:Class="YahooMonthPrint.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yahoo Month Print Settings"
        Width="650"
        Height="540"
        MinWidth="580"
        MinHeight="470"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="Yahoo Account">
                <StackPanel Margin="16">
                    <TextBlock FontWeight="SemiBold" Text="Connected account" />
                    <TextBlock x:Name="AccountText" Margin="0,5,0,16" />
                    <Button Width="130" MinHeight="32" HorizontalAlignment="Left" Click="OnTestConnection" Content="Test Connection" />
                    <TextBlock x:Name="ConnectionStatusText" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="Change app password" />
                    <PasswordBox x:Name="NewPasswordBox" Width="300" MinHeight="32" Margin="0,5,0,6" HorizontalAlignment="Left" />
                    <Button Width="150" MinHeight="32" HorizontalAlignment="Left" Click="OnChangePassword" Content="Save New Password" />
                    <Separator Margin="0,22,0,14" />
                    <Button Width="120" MinHeight="32" HorizontalAlignment="Left" Click="OnDisconnect" Content="Disconnect" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="#FF5D626B"
                               Text="Disconnect removes the saved password and local data. It does not revoke the app password at Yahoo."
                               TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Calendars">
                <StackPanel Margin="16">
                    <TextBlock Margin="0,0,0,10" Text="Choose calendars to retrieve, display, and print." />
                    <ListBox x:Name="CalendarsList" MinHeight="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox MinHeight="32" Margin="8,2" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Display">
                <StackPanel Margin="16">
                    <TextBlock Text="Default detail level" />
                    <ComboBox x:Name="DetailLevelCombo" Width="220" Margin="0,5,0,14" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Titles Only" Tag="TitlesOnly" />
                        <ComboBoxItem Content="Compact" Tag="Compact" />
                        <ComboBoxItem Content="Detailed" Tag="Detailed" />
                    </ComboBox>
                    <TextBlock Text="Maximum description lines" />
                    <ComboBox x:Name="DescriptionLinesCombo" Width="100" Margin="0,5,0,14" HorizontalAlignment="Left">
                        <ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" />
                    </ComboBox>
                    <CheckBox x:Name="ShowLocationsCheckBox" Content="Show event locations" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Printing">
                <StackPanel Margin="16">
                    <TextBlock Text="Paper size" />
                    <ComboBox x:Name="PaperSizeCombo" Width="220" Margin="0,5,0,14" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Printer default" /><ComboBoxItem Content="Letter" /><ComboBoxItem Content="A4" />
                    </ComboBox>
                    <TextBlock Text="Orientation" />
                    <ComboBox x:Name="OrientationCombo" Width="220" Margin="0,5,0,14" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Landscape" /><ComboBoxItem Content="Portrait" />
                    </ComboBox>
                    <TextBlock Text="Default overflow handling" />
                    <ComboBox x:Name="OverflowPolicyCombo" Width="260" Margin="0,5,0,14" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Reduce detail automatically" />
                        <ComboBoxItem Content="Use smaller text" />
                        <ComboBoxItem Content="Print overflow details on page 2" />
                    </ComboBox>
                    <TextBlock Foreground="#FF5D626B"
                               Text="Paper, margins, detail, and font size can also be adjusted in Print Preview."
                               TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Privacy">
                <StackPanel Margin="16">
                    <TextBlock Text="Cached event data helps the calendar remain usable while Yahoo is unavailable." TextWrapping="Wrap" />
                    <Button Width="210" MinHeight="34" Margin="0,16,0,0" HorizontalAlignment="Left" Click="OnClearCache" Content="Clear Cached Calendar Data" />
                    <TextBlock x:Name="PrivacyStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Margin="0,20,0,0"
                               Foreground="#FF5D626B"
                               Text="The app password is kept in Windows Credential Manager and is never stored in settings or the calendar cache."
                               TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90" MinHeight="34" Margin="0,0,8,0" IsCancel="True" Content="Cancel" />
            <Button Width="90" MinHeight="34" Click="OnSave" IsDefault="True" Content="Save" />
        </StackPanel>
    </Grid>
</Window>
