<Window x:Class="YahooMonthPrint.App.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview — Yahoo Month Print"
        Width="1180"
        Height="820"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#FFF2F3F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="12,10,12,6" VerticalAlignment="Center">
            <TextBlock Margin="4,0" VerticalAlignment="Center" Text="Printer" />
            <ComboBox x:Name="PrinterCombo" Width="215" Margin="2" />
            <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Paper" />
            <ComboBox x:Name="PaperCombo" Width="90" Margin="2" SelectionChanged="OnOptionsChanged">
                <ComboBoxItem Content="Letter" Tag="Letter" />
                <ComboBoxItem Content="A4" Tag="A4" />
            </ComboBox>
            <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Orientation" />
            <ComboBox x:Name="OrientationCombo" Width="105" Margin="2" SelectionChanged="OnOptionsChanged">
                <ComboBoxItem Content="Landscape" Tag="Landscape" />
                <ComboBoxItem Content="Portrait" Tag="Portrait" />
            </ComboBox>
            <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="Margins" />
            <ComboBox x:Name="MarginsCombo" Width="90" Margin="2" SelectionChanged="OnOptionsChanged">
                <ComboBoxItem Content="0.25 in" Tag="0.25" />
                <ComboBoxItem Content="0.5 in" Tag="0.5" />
                <ComboBoxItem Content="0.75 in" Tag="0.75" />
            </ComboBox>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="4,0,12,0">
                <TextBlock Text="Detail level" />
                <ComboBox x:Name="DetailCombo" Width="110" Margin="0,3,0,0" SelectionChanged="OnOptionsChanged">
                    <ComboBoxItem Content="Titles Only" Tag="TitlesOnly" />
                    <ComboBoxItem Content="Compact" Tag="Compact" />
                    <ComboBoxItem Content="Detailed" Tag="Detailed" />
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="DescriptionLinesPanel" Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Description" />
                <ComboBox x:Name="DescriptionLinesCombo" Width="80" Margin="0,3,0,0" SelectionChanged="OnOptionsChanged">
                    <ComboBoxItem Content="1 line" Tag="1" />
                    <ComboBoxItem Content="2 lines" Tag="2" />
                    <ComboBoxItem Content="3 lines" Tag="3" />
                    <ComboBoxItem Content="4 lines" Tag="4" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="Body text" />
                <ComboBox x:Name="FontSizeCombo" Width="70" Margin="0,3,0,0" SelectionChanged="OnOptionsChanged">
                    <ComboBoxItem Content="7 pt" Tag="7" />
                    <ComboBoxItem Content="8 pt" Tag="8" />
                    <ComboBoxItem Content="9 pt" Tag="9" />
                    <ComboBoxItem Content="10 pt" Tag="10" />
                    <ComboBoxItem Content="11 pt" Tag="11" />
                    <ComboBoxItem Content="12 pt" Tag="12" />
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="ShowLocationsCheckBox"
                      Grid.Column="3"
                      Margin="0,22,18,0"
                      VerticalAlignment="Top"
                      Checked="OnOptionsChanged"
                      Content="Locations"
                      Unchecked="OnOptionsChanged" />
            <StackPanel Grid.Column="4">
                <TextBlock Text="Overflow handling" />
                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                    <RadioButton x:Name="AutomaticRadio" Margin="0,0,12,0" Checked="OnOptionsChanged" Content="Reduce detail automatically" GroupName="Overflow" />
                    <RadioButton x:Name="SmallerTextRadio" Margin="0,0,12,0" Checked="OnOptionsChanged" Content="Use smaller text" GroupName="Overflow" />
                    <RadioButton x:Name="DetailsPagesRadio" Checked="OnOptionsChanged" Content="Print details pages" GroupName="Overflow" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="OverflowWarning"
                    Margin="12,0,12,8"
                    Padding="10,7"
                    Background="#FFFFF4CE"
                    BorderBrush="#FF9B7500"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="OverflowWarningText" TextWrapping="Wrap" />
            </Border>
            <DocumentViewer x:Name="PreviewViewer" Grid.Row="1" Margin="12,0" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="12,10" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90" MinHeight="34" Margin="0,0,8,0" IsCancel="True" Content="Close" />
            <Button Width="110" MinHeight="34" Click="OnPrint" IsDefault="True" Content="Print…" />
        </StackPanel>
    </Grid>
</Window>
